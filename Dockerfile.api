FROM python:3.11-slim

WORKDIR /app

# Install both core sync dependencies and API dependencies
COPY requirements.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-api.txt

COPY src/ ./src/
COPY config/ ./config/

# Health check: poll /health every 30 s, 5 s timeout, 3 retries
# Uses python stdlib so no extra deps are needed
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

# Use exec form so uvicorn receives SIGTERM directly (proper graceful shutdown)
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

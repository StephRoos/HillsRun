# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=garmin_connect
POSTGRES_USER=garmin
POSTGRES_PASSWORD=your_secure_password_here

# API Authentication
# Generate with: openssl rand -base64 32
API_KEY=your_secret_api_key_here

# Garmin Token Encryption (Fernet symmetric key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_KEY=your_fernet_key_here

# Garmin Tokens Directory (host path for OAuth token files)
# Default: ~/.garminconnect
GARMIN_TOKENS_DIR=~/.garminconnect

# Application Configuration
LOG_LEVEL=INFO
CONFIG_PATH=/app/config/config.yaml
API_PORT=8100

# Optional: Timezone
TZ=Europe/Paris

# ──────────────────────────────────────────────
# UM880 / Coolify (docker-compose.coolify.yml) — set these in the Coolify UI.
# In the compose: POSTGRES_HOST=db, DATABASE_URL / GARMIN_API_URL / GARMIN_API_KEY
# are derived automatically. Runbook: docs/DEPLOY-UM880.md
# ──────────────────────────────────────────────
# BETTER_AUTH_SECRET=...                 # openssl rand -base64 32
# BETTER_AUTH_URL=https://hillsrun.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://hillsrun.com

# ── DEPRECATED (pre-UM880, kept for reference, see legacy/) ──
# NAS replica (legacy/docker-compose.nas.yml):
# REPLICA_PASSWORD=your_replica_password_here
# Neon logical replication (scripts/setup-replica.sh):
# NEON_REPLICATION_CONNSTRING=postgresql://replicator:password@ep-xxx.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────
# Frontend (web/.env.local) — copy these to web/.env.local
# ──────────────────────────────────────────────

# PostgreSQL connection string for Prisma (auth tables)
# DATABASE_URL=postgresql://user:password@localhost:5432/hillsrun

# FastAPI backend URL (server-side only)
# GARMIN_API_URL=http://localhost:8100

# API key matching the backend API_KEY above (server-side only)
# GARMIN_API_KEY=your_secret_api_key_here

# Better-Auth session secret
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET=your_better_auth_secret_here

# Better-Auth public URL (used client-side)
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

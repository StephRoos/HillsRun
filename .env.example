# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=garmin_connect
POSTGRES_USER=garmin
POSTGRES_PASSWORD=your_secure_password_here

# API Authentication
# Generate with: openssl rand -base64 32
API_KEY=your_secret_api_key_here

# Garmin Token Encryption (Fernet symmetric key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_TOKEN_KEY=your_fernet_key_here

# Garmin Tokens Directory (host path for OAuth token files)
# Default: ~/.garminconnect
GARMIN_TOKENS_DIR=~/.garminconnect

# Application Configuration
LOG_LEVEL=INFO
CONFIG_PATH=/app/config/config.yaml
API_PORT=8100

# Optional: Timezone
TZ=Europe/Paris
